# ---- backend (private, never shipped to browsers) ----
# CORS_ORIGINS = comma-separated web origins allowed to call the API with cookies.
# Production example: CORS_ORIGINS=https://a3kitchen.in,https://www.a3kitchen.in
NODE_ENV=development
PORT=4000
# Leave empty in development to use an in-memory MongoDB replica set.
MONGODB_URI=
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# TEST = also offer the simulated "Test payment" method. LIVE = Razorpay + COD only.
PAYMENT_MODE=TEST
# Razorpay (server only). Key id is public; secret + webhook secret never leave the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
OTP_TTL_SECONDS=900
OTP_MAX_ATTEMPTS=5
LOG_LEVEL=info

# Cloudinary (server only — never expose the secret to clients)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — Gmail SMTP with an app password (Google Account → Security → App passwords).
# Leave SMTP_USER empty in development to log emails to the console instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_URL=http://localhost:5173
