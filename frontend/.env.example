# ---- web app (public: Vite only exposes VITE_* variables to the browser) ----
# Backend server address. Every page calls `${VITE_API_URL}/api/v1/...` (src/lib/api.ts).
# Local: http://localhost:4000    Production: your deployed backend, e.g. https://api.a3kitchen.in
# The website's address must be listed in the backend's CORS_ORIGINS.
VITE_API_URL=http://localhost:4000
